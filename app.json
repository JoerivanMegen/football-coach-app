{
  "expo": {
    "name": "Assistant Coach",
    "slug": "football-coach-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/assistant-coach-app-icon-1024.png",
    "scheme": "footballcoachapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/assistant-coach-app-icon-1024.png",
      "bundleIdentifier": "com.joerivanmegen.football-coach-app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "allowBackup": true,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/assistant-coach-app-icon-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.joerivanmegen.footballcoachapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/assistant-coach-splash-transparent.png",
          "imageWidth": 260,
          "resizeMode": "contain"
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/assistant-coach-notification-icon.png",
          "color": "#1C7C54"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f1477750-7fa7-4d19-930a-c02da31495f4"
      }
    }
  }
}
